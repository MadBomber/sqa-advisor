#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "readline"
require_relative "../lib/sqa/advisor"

BANNER = <<~BANNER
  +---------------------------------------------------+
  |   SQA Advisor  --  AI Investment Analyst          |
  |   Powered by Claude + SQA + Yahoo Finance         |
  |   Type 'exit', 'quit', or Ctrl+D to quit         |
  |   Type 'reset' to start a new conversation       |
  +---------------------------------------------------+
BANNER

puts BANNER

unless ENV["ANTHROPIC_API_KEY"] || ENV["OPENAI_API_KEY"]
  warn "Warning: No API key found. Set ANTHROPIC_API_KEY or OPENAI_API_KEY in .env"
  exit 1
end

model = ENV.fetch("SQA_ADVISOR_MODEL", "claude-sonnet-4-6")
puts "Using model: #{model}\n\n"

begin
  agent = SQA::Advisor::Agent.new(model: model)
rescue StandardError => e
  warn "Failed to initialize SQA Advisor: #{e.message}"
  exit 1
end

# Convert snake_case tool name to PascalCase for display (e.g. stock_price → StockPrice)
def tool_label(name)
  name.to_s.split("_").map(&:capitalize).join
end

agent.on_tool_call do |tool_call|
  puts "  [#{tool_label(tool_call.name)}]"
end

Readline.completion_proc = proc { |_| [] }

loop do
  raw = Readline.readline("\nYou: ", true)

  if raw.nil?
    puts "\nGoodbye!"
    break
  end

  input = raw.strip
  next if input.empty?

  case input.downcase
  when "exit", "quit", "bye"
    puts "\nGoodbye!"
    break
  when "reset"
    agent.reset
    puts "[New conversation started]"
    next
  end

  puts ""

  begin
    header_printed = false

    agent.ask(input) do |chunk|
      text = chunk.content.to_s
      next if text.empty?

      unless header_printed
        print "Advisor: "
        header_printed = true
      end

      print text
      $stdout.flush
    end

    puts "\n"
  rescue Interrupt
    puts "\n[Interrupted]"
    break
  rescue StandardError => e
    puts "Error: #{e.message}"
  end
end
