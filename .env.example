# Copy to .env and fill in your keys.
# sqa-advisor defaults to Anthropic Claude. Set OPENAI_API_KEY to use OpenAI instead.

ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Alpha Vantage key for SQA data fetching
# AV_API_KEY=your_alpha_vantage_key_here

# Optional: override the default model (default: claude-sonnet-4-6)
# SQA_ADVISOR_MODEL=claude-opus-4-7

# Optional: manually supply Yahoo Finance session credentials.
# Only needed if your IP is temporarily rate-limited by Yahoo Finance.
# To obtain: open finance.yahoo.com in a browser, DevTools → Application → Cookies,
# copy A1/A1S/A3 values as "Name=Value; Name2=Value2", then visit
# finance.yahoo.com/v1/test/getcrumb in the same session for the crumb.
# YF_COOKIE=A1=xxx; A1S=yyy; A3=zzz
# YF_CRUMB=your_crumb_here
