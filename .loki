# frozen_string_literal: true
# sqa-advisor — agentic Claude/RubyLLM investment advisor CLI built on sqa.

import_up "repo_dev.loki"

class Tasks
  @@gem_name ||= "sqa-advisor".freeze

  header "sqa-advisor v#{gem_version} — AI investment advisor CLI"

  desc "Launch the interactive sqa-advisor REPL"
  def repl
    sh "bin/sqa-advisor"
  end
end
